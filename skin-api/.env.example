NODE_ENV=production
NPM_DOCKER_NETWORK=replace-with-existing-npm-network
PUBLIC_BASE_URL=https://westronskin.sytes.net
HOST=127.0.0.1
PORT=3000
DATA_DIR=/data
DATABASE_PATH=/data/db/skin-api.sqlite
SKINS_DIR=/data/skins
UPDATES_DIR=/data/updates
UPDATE_PUBLISHER_EMAIL=ermiscaner78@gmail.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ONE_TIME_TOKEN_TTL_MINUTES=30
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW=15 minutes
CORS_ORIGINS=
TRUST_PROXY=
LOG_LEVEL=info
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=Westron Skin API <your-account@gmail.com>
